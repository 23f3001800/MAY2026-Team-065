# Database — each dev sets their own local Postgres password here.
# Create the DB first:  createdb complaint_db
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/complaint_db

# Security & Authentication
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI ---------------------------------------------------------------
# Everything below is OPTIONAL. With no configuration the API still does
# categorisation, severity scoring and duplicate detection using the built-in
# deterministic engine; only image analysis, description write-ups and the
# natural-language assistant need a Gemini key.

# auto   = use Gemini when GEMINI_API_KEY is set, otherwise the rules engine
# rules  = never call out to an LLM (use for CI, offline demos, and tests)
# gemini = require Gemini
AI_PROVIDER=auto

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-2.5-flash is stable and multimodal. For lower cost/latency on current
# generation models, try gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta


# --- Azure OpenAI / Azure AI Foundry ---------------------------------------
# The KEY ALONE is enough. With just AZURE_OPENAI_API_KEY set, requests go to
# the Foundry model-inference endpoint, which needs no deployment -- the model
# is named per request and defaults to AZURE_OPENAI_MODEL below.
#
# If instead you have provisioned an Azure OpenAI *resource* (its own URL, with
# a deployment you created), set ENDPOINT and DEPLOYMENT as well and that path
# is used instead. DEPLOYMENT is the name YOU gave the deployment, not the
# model name.
#
# With both Azure and Gemini configured, AI_PROVIDER=auto prefers Azure.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4o-mini

# Only for an Azure OpenAI resource. Leave blank for Foundry inference.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Override only if Foundry gave you a project-specific inference URL.
AZURE_OPENAI_INFERENCE_ENDPOINT=https://models.inference.ai.azure.com

# Per-call budget. Kept short so complaint submission never hangs on the model.
AI_TIMEOUT_SECONDS=12
AI_MAX_OUTPUT_TOKENS=1024

# Largest image accepted for vision analysis, in bytes (default 4 MB).
AI_MAX_IMAGE_BYTES=4194304

# Run triage automatically when a complaint is filed.
AI_AUTO_TRIAGE=true

# Duplicate detection thresholds.
AI_DUPLICATE_RADIUS_KM=0.3
AI_DUPLICATE_WINDOW_DAYS=30
# Score needed to SHOW a complaint as a possible duplicate.
AI_DUPLICATE_THRESHOLD=0.55
# Higher bar to actually LINK it on the complaint record. A false link hides a
# second citizen's report behind the first, so this is deliberately stricter.
AI_DUPLICATE_AUTOLINK_THRESHOLD=0.75

# --- Complaint lifecycle ----------------------------------------------
# Feedback at or below this star rating on a RESOLVED complaint reopens it
# automatically. Set to 0 to disable and leave reopening to officers.
REOPEN_ON_RATING=2

# --- SLA monitoring ---------------------------------------------------
# Officers are alerted once when an open complaint passes its resolution
# target. Targets are in hours, measured from when the complaint was filed.
SLA_ENABLED=true
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=72
SLA_LOW_HOURS=168
# How often the background sweeper runs. Minimum 1 minute.
SLA_SWEEP_MINUTES=15
# Running several API instances? Set SLA_ENABLED=false and drive
# POST /admin/sla/sweep from cron instead, so sweepers don't race.

# --- Email ------------------------------------------------------------
# Used for two things: sending sign-in details to an officer or field worker an
# administrator has just created, and sending the verification code for a
# forgotten password.
#
# ALL OPTIONAL. With SMTP_HOST unset nothing is sent, the API logs what it
# would have sent (including the reset code, so a local reset can still be
# completed), and every endpoint carries on working. Account creation reports
# back whether the message actually left, so an administrator knows whether
# they still have to make contact themselves.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on the submission port (587). For implicit TLS on 465 set
# SMTP_USE_SSL=true and SMTP_USE_TLS=false instead.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Defaults to SMTP_USERNAME when blank.
MAIL_FROM=
MAIL_FROM_NAME=CivicConnect
SUPPORT_EMAIL=support@civicconnect.gov.in
APP_NAME=CivicConnect
# Where the sign-in link in those emails points.
APP_PUBLIC_URL=http://localhost:3000

# --- Password reset ---------------------------------------------------
# A six-digit code, emailed. What keeps it safe is the short life and the
# attempt limit, not the length: a code dies after 5 wrong answers, when it
# expires, or when a newer one is issued.
PASSWORD_RESET_CODE_TTL_MINUTES=15
# Codes one account may be sent per hour. Limits inbox flooding, which is the
# abuse this endpoint actually enables.
PASSWORD_RESET_MAX_PER_HOUR=5

# --- Caching ----------------------------------------------------------
# In-process only, and deliberately short. Analytics answers are reused across
# officers loading the same dashboard; set to 0 to disable entirely.
ANALYTICS_CACHE_SECONDS=30
# Cache-Control max-age on reference data (/categories). It also carries an
# ETag computed from the rows, so adding a category invalidates client copies
# immediately rather than after this lapses.
REFERENCE_CACHE_SECONDS=60
