# Database — each dev sets their own local Postgres password here.
# Create the DB first:  createdb complaint_db
# DATABASE_URL=postgresql+asyncpg://postgres:1234abCD&l@localhost:5432/complaint_db
DATABASE_URL=postgresql+asyncpg://postgres:1234abCD%26l@localhost:5432/complaint_db
# Security & Authentication
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI ---------------------------------------------------------------
# Everything below is OPTIONAL. With no configuration the API still does
# categorisation, severity scoring and duplicate detection using the built-in
# deterministic engine; only image analysis, description write-ups and the
# natural-language assistant need a Gemini key.

# auto   = use Gemini when GEMINI_API_KEY is set, otherwise the rules engine
# rules  = never call out to an LLM (use for CI, offline demos, and tests)
# gemini = require Gemini
AI_PROVIDER=auto

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-2.5-flash is stable and multimodal. For lower cost/latency on current
# generation models, try gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Per-call budget. Kept short so complaint submission never hangs on the model.
AI_TIMEOUT_SECONDS=12
AI_MAX_OUTPUT_TOKENS=1024

# Largest image accepted for vision analysis, in bytes (default 4 MB).
AI_MAX_IMAGE_BYTES=4194304

# Run triage automatically when a complaint is filed.
AI_AUTO_TRIAGE=true

# Duplicate detection thresholds.
AI_DUPLICATE_RADIUS_KM=0.3
AI_DUPLICATE_WINDOW_DAYS=30
# Score needed to SHOW a complaint as a possible duplicate.
AI_DUPLICATE_THRESHOLD=0.55
# Higher bar to actually LINK it on the complaint record. A false link hides a
# second citizen's report behind the first, so this is deliberately stricter.
AI_DUPLICATE_AUTOLINK_THRESHOLD=0.75

# --- Complaint lifecycle ----------------------------------------------
# Feedback at or below this star rating on a RESOLVED complaint reopens it
# automatically. Set to 0 to disable and leave reopening to officers.
REOPEN_ON_RATING=2

# --- SLA monitoring ---------------------------------------------------
# Officers are alerted once when an open complaint passes its resolution
# target. Targets are in hours, measured from when the complaint was filed.
SLA_ENABLED=true
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=72
SLA_LOW_HOURS=168
# How often the background sweeper runs. Minimum 1 minute.
SLA_SWEEP_MINUTES=15
# Running several API instances? Set SLA_ENABLED=false and drive
# POST /admin/sla/sweep from cron instead, so sweepers don't race.
